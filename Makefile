# port3 - cross-platform (POSIX) build entry.
#
#   make            # generate the data-segment image, then build host/build/fd2engine
#   make check      # syntax-check the host + game sources
#   make clean
#
# Put your own FD2.EXE in this directory (it is .gitignore'd) or pass
#   FD2_EXE=/path/to/FD2.EXE make
# The image is generated by tools/prepare_image.py, which stops with
# instructions if neither the segment data nor FD2.EXE is available.
#
# Platforms: Linux and macOS are wired up in host/Makefile (sokol auto-picks
# OpenGL / Metal; platform_posix.c has portable fallbacks).  On Windows use
# `pwsh -File build.ps1` (MSVC) instead of this Makefile.

PYTHON ?= python3
export FD2_EXE

.PHONY: all engine check clean

all: engine

engine:
	$(MAKE) -C host engine PYTHON="$(PYTHON)"

check:
	$(MAKE) -C host check PYTHON="$(PYTHON)"

clean:
	$(MAKE) -C host clean
	rm -f src/fd2_image.c analysis/seg_dseg02.bin analysis/seg_dseg03.bin
