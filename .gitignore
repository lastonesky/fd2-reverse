host/build/
*.o

build/

# --- 不属于本仓库的派生物（体积大 + 可由原版程序/IDA/Ghidra 重新获得）---------
# 重建仓库后若要编译/重生成头文件，必须先按 EXTERNAL_ARTIFACTS.md 从外部 IDB
# 重新导出这些文件；它们不再入库（见该文件“已移出 git”一节）。
analysis/decomp/
analysis/disasm_fallback/
analysis/cseg01_disasm.txt
analysis/seg_*.bin
analysis/arity.json
analysis/callgraph.csv
analysis/compile_errors.txt
analysis/data_items.csv
analysis/data_type_overrides.csv
analysis/decomp_failures.csv
analysis/dispatch_tables.csv
analysis/funcmap.csv
analysis/names.csv
analysis/prototype_heal_log.json
analysis/prototypes.csv
analysis/reloc_suspects.csv
analysis/strings.csv
function-map.csv

# Generated at build time by tools/prepare_image.py from the original EXE.
# This is copyrighted game data - never commit the segments or the image:
analysis/seg_*.bin
src/fd2_image.c

# Generated by tools/fd2_dialogue.py; keep the generator, not the 3.4 MB PDF.
docs/dialogue.pdf

# The original executable may sit in the repo root during development, but it
# is the user's own copy and must never be committed:
/FD2.EXE

# Runtime logs and agent scratch / python caches (not source):
*.log
__pycache__/
.workbuddy/

# IDA 打开仓库根目录的 FD2.EXE 时会就地在旁边摊开数据库：.i64（打包）、
# 未打包时的 .id0/.id1/.id2/.nam/.til，以及崩溃后留下的 .crash-* 目录。
# 这些全是临时产物（带全部命名/原型的那份 IDB 登记在 EXTERNAL_ARTIFACTS.md，
# 路径 E:\FD2\FD2.EXE.i64），不进仓库。
/FD2.EXE.i64
/FD2.EXE.i64.crash-*/
/FD2.EXE.id[0-9]
/FD2.EXE.id1
/FD2.EXE.nam
/FD2.EXE.til
*.id0
*.id1
*.id2
*.nam
*.til

# shell 重定向/命令误用留下的文件（例如 `magick ... > --help`、
# `python tools/fd2sav.py --help > --help`），曾攒下 30MB 垃圾。
/--help

# 隔离测试目录（见 AGENTS.md §0.2），里面常有 FD2.SAV 副本和大体积游戏数据。
/testdata/
